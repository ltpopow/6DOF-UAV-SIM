{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                    "/Zi",
                    "/EHsc",
                    "/nologo",
                    "/std:c++20",
                    "/Fe${workspaceFolder}\\main.exe",
                    "${workspaceFolder}\\main.cpp",
                    "${workspaceFolder}\\dynamics.cpp",
                    "${workspaceFolder}\\integration.cpp",
                    "${workspaceFolder}\\aerodynamics.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}